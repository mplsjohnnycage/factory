{
  "name": "@factory/sandbox-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Factory AgentSession harness: Sandbox Agent Docker + Claude Code (M1)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node --import tsx src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "sandbox-agent": "0.5.4"
  },
  "peerDependencies": {
    "dockerode": ">=4.0.0",
    "get-port": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "dockerode": { "optional": true },
    "get-port": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
