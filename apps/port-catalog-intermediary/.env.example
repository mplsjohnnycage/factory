# Port credentials for the API — held ONLY by this process, never the gateway.
# Values come from the vault / a 0600 keys.local at deploy time. Never commit.
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=

# Port API base (EU default; US orgs use https://api.us.port.io)
PORT_API_BASE_URL=https://api.getport.io

# Execution mode: "workflow" (start + poll Port workflow runs) or "entity"
# (direct entity API through this intermediary — see README "Live modes").
PORT_CATALOG_MODE=workflow

# Required in workflow mode: Port workflow/action identifiers.
PORT_CATALOG_READ_WORKFLOW_ID=factory_catalog_read
PORT_CATALOG_UPSERT_WORKFLOW_ID=factory_catalog_upsert

# Bind: same host as the gateway by default (loopback). Tailnet bind is the
# alternative if the gateway lives on another box — never a public bind.
INTERMEDIARY_HOST=127.0.0.1
INTERMEDIARY_PORT=8788

# Poll cadence + deadline. Deadline MUST stay under the gateway's 10s
# round-trip timeout unless the gateway timeout is raised in the same change.
INTERMEDIARY_POLL_INTERVAL_MS=500
INTERMEDIARY_RUN_DEADLINE_MS=9000
