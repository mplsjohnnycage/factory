# Factory Developer OS — Port External Interface (ADR-005 live)
# Dedicated Factory app client id ONLY — never Harness Observatory / Clerk.
# Public PKCE identifier (no client secret). Live value from OpenAccess / Port MCP.

PORT_FACTORY_CLIENT_ID=tnPUmUX5M0h8CdTZtaEbhhMOX0VFkUc0
# Do NOT set PORT_OBSERVATORY_CLIENT_ID — Contract forbids it.

# Optional overrides (EU production defaults match openmcp.port.io / api.getport.io)
# PORT_AUTH0_DOMAIN=auth.getport.io
# PORT_API_BASE=https://api.getport.io
# PORT_OAUTH_AUTHORIZE_URL=https://auth.getport.io/authorize
# PORT_OAUTH_TOKEN_URL=https://auth.getport.io/oauth/token
# PORT_OAUTH_SCOPES=openid profile email offline_access

# Canonical public origin for Port OAuth redirect_uri (…/api/auth/callback).
# Production on Vercel hard-pins to https://factory-developer-os.vercel.app when unset.
# Set this on every Vercel target so authorize never falls back to ephemeral VERCEL_URL.
# NEXT_PUBLIC_DEVOS_URL=http://localhost:3000
# NEXT_PUBLIC_DEVOS_URL=https://factory-developer-os.vercel.app

# Rivet Actor Serve (PBI-009). When unset, Dev OS uses Memory fixture stream.
# RIVET_SERVE_URL=https://rivet.tailnet.ts.net
# RIVET_ADMIN_TOKEN=
