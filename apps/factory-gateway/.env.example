# Port classic webhook HMAC secret (never commit real values)
PORT_CLIENT_SECRET=

# §4.2.1 catalog writer store backend: "memory" (default; tests / dry-runs)
# or "workflow" (applies land in Port via the factory_* workflow WEBHOOK
# round-trip — spec option (b); the gateway holds NO Port REST credential).
FACTORY_CATALOG_STORE=memory

# Required when FACTORY_CATALOG_STORE=workflow: Port workflow catalog
# round-trip endpoint (catalog_read / catalog_upsert envelopes).
PORT_CATALOG_WORKFLOW_URL=

# Listen bind (default 0.0.0.0:8787)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8787

# Optional: POST admit payloads to Rivet / ProjectSupervisor HTTP entry
# When unset, admits stay in the in-process supervisor queue (never polls Port)
RIVET_SUPERVISOR_URL=

# PBI-012 — gateway rate limit (sliding window)
GATEWAY_RATE_LIMIT_RPM=60
GATEWAY_RATE_LIMIT_WINDOW_MS=60000

# PBI-012 — optional OpenFleet ledger root (JSONL under fleets/<fleet>/ledger.jsonl)
# When unset, ceiling.refuse events stay in-process (CI / MemoryOpenFleetLedger)
# OPENFLEET_HOME=

# Meta Port self-service handlers (POST /handlers/self-service)
# Port WEBHOOK Authorization: Bearer <token> — store same value as Port secret FACTORY_GATEWAY_HANDLER_TOKEN
FACTORY_GATEWAY_HANDLER_TOKEN=

# Convex Management API team access token (ss_convex_* Meta handlers)
# Also store as Port secret CONVEX_TEAM_TOKEN when calling Convex from Port-native WEBHOOKs
CONVEX_TEAM_TOKEN=
