{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "tags": ["ci"]
    },
    "test": {
      "tags": ["ci"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    }
  }
}
