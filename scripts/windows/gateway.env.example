# Copy to %USERPROFILE%\.factory\gateway.env on DESKTOP-3APDBKG.
# NEVER commit the real gateway.env. NEVER paste secret values into git/PRs/chat.

# Required for Port HMAC admits (match Port Client Secret / classic webhook secret)
PORT_CLIENT_SECRET=

# Meta self-service bearer (same value as Port secret FACTORY_GATEWAY_HANDLER_TOKEN)
FACTORY_GATEWAY_HANDLER_TOKEN=

# Listen bind (defaults match apps/factory-gateway)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8787

# Optional: Rivet / ProjectSupervisor HTTP admit URL (Tailscale Serve)
# RIVET_SUPERVISOR_URL=

# Optional: Meta ss_convex_* (also store as Port secret CONVEX_TEAM_TOKEN when used)
# CONVEX_TEAM_TOKEN=
