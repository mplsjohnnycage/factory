# Copy to %USERPROFILE%\.factory\omniroute.env on the operator desktop (optional).
# NEVER commit the real omniroute.env. NEVER paste API keys into git/PRs/chat.
# Provider keys belong in the OmniRoute dashboard (encrypted at rest) — not here for the staged kit.

# Loopback bind preference (npm / process env; Docker uses compose .env instead)
APP_BIND_HOST=127.0.0.1

# Unified dashboard + /v1 port (upstream default)
OMNIROUTE_PORT=20128

# When true, /v1 expects a local OmniRoute API key (create in dashboard) — optional for /healthz
REQUIRE_API_KEY=false

# Optional data directory override (Windows default is %APPDATA%\omniroute when ~/.omniroute absent)
# DATA_DIR=

# Optional: point CLI helpers at a running instance (no secret value here)
OMNIROUTE_BASE_URL=http://127.0.0.1:20128

# DO NOT set provider secrets in this file for the staged install path:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OMNIROUTE_API_KEY=
