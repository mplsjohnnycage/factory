{
  "name": "@factory/meta",
  "version": "0.1.0",
  "private": true,
  "description": "Factory Meta repo root — local gate + LogicSRC validators + OpenPRD + Turborepo CI",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/factory-gateway",
    "apps/developer-os",
    "apps/project-supervisor",
    "apps/sandbox-harness"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "local-gate": "node scripts/local-gate.mjs",
    "test": "node --test scripts/local-gate-refuse.test.mjs",
    "test:local-gate": "node --test scripts/local-gate-refuse.test.mjs",
    "test:packages": "turbo run test",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "validate:well-known": "node scripts/validate-well-known.mjs",
    "validate:openprd": "node scripts/local-gate.mjs",
    "smoke:atlas-bff": "node scripts/atlas-bff-smoke.mjs",
    "dry-run:omniroute-desktop": "node scripts/omniroute-desktop-dry-run.mjs",
    "dry-run:gateway-unsigned": "node scripts/gateway-unsigned-admit-dry-run.mjs",
    "dry-run:supervisor-admit": "node scripts/supervisor-admit-dry-run.mjs",
    "dry-run:windows-logon": "node scripts/gateway-windows-logon-dry-run.mjs"
  },
  "dependencies": {
    "@logicsrc/openprd": "^0.2.0",
    "@logicsrc/validators": "0.6.0"
  },
  "devDependencies": {
    "turbo": "^2.11.7"
  }
}
