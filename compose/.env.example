# Copy to compose/.env on the desktop pilot host (gitignored).
# openssl rand -hex 32
RIVET_ADMIN_TOKEN=replace-with-openssl-rand-hex-32

# Optional overrides
# RIVET_ENGINE_IMAGE=rivetdev/engine:2.3.3
# RIVET_HOST_PORT=6420

# After Serve is up, record the HTTPS URL for evidence (not a secret):
# FACTORY_RIVET_SERVE_URL=https://<hostname>.<tailnet>.ts.net

# --- profile `gateway` only (docker compose --profile gateway up -d) ---
# GATEWAY_HOST_PORT=8787
# PORT_CLIENT_SECRET=
# FACTORY_GATEWAY_HANDLER_TOKEN=
# CONVEX_TEAM_TOKEN=
# RIVET_SUPERVISOR_URL=http://rivet-engine:6420
# GATEWAY_RATE_LIMIT_RPM=60
